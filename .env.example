# 변수 이름만 둡니다. 값은 scripts/create-env 가 채우거나 사용자가 직접 넣습니다. (ARCHITECTURE.md 7장)
# 이 파일에는 값을 적지 않습니다.

# Upstage Studio
# UPSTAGE_MODE: live(실제 API 호출) 또는 replay(저장해 둔 실제 응답을 돌려줌, 키 없이 화면 시험용)
UPSTAGE_MODE=
# 아래 세 값은 사용자가 직접 입력
UPSTAGE_API_KEY=
UPSTAGE_PROJECT_ID=
UPSTAGE_AGENT_ID=
UPSTAGE_CONFIG_ID=
UPSTAGE_BASE_URL=
UPSTAGE_POLL_INTERVAL_MS=
UPSTAGE_JOB_TIMEOUT_SEC=

# 데이터베이스 (DB_PASSWORD 는 스크립트가 생성, docker-compose.yml 도 읽음)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 애플리케이션 (APP_ENCRYPTION_KEY 는 스크립트가 생성)
APP_ENCRYPTION_KEY=
APP_STORAGE_DIR=
APP_RETENTION_HOURS=
APP_COOKIE_SECURE=
